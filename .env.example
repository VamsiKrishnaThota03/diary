# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/diary
# Login for the diary (HTTP Basic auth). Use a long, unique password.
DIARY_USERNAME=me
DIARY_PASSWORD=change-me
# Port and bind address (use HOST=0.0.0.0 only on a host such as Render)
PORT=3000
HOST=127.0.0.1

# Optional: requests per IP per 15 minutes before the app rate limits (default 60)
AUTH_RATE_LIMIT_MAX=60
