<%- include('./layout/header', { title: 'New entry' }) %>
<%- include('./layout/navbar') %>
    <section class="panel form-panel">
        <h1>New <span class="green-text">entry</span></h1>
        <%- include('./layout/errors') %>
        <form action="/add-to-diary" method="post">
            <%- include('./layout/form', { entry }) %>
            <div class="actions">
                <button type="submit" class="btn">Save entry</button>
                <a class="btn btn-ghost" href="/diary">Cancel</a>
            </div>
        </form>
    </section>
<%- include('./layout/footer') %>
