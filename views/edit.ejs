<%- include('./layout/header', { title: 'Edit entry' }) %>
<%- include('./layout/navbar') %>
    <section class="panel form-panel">
        <h1>Edit <span class="green-text">entry</span></h1>
        <%- include('./layout/errors') %>
        <form action="/diary/edit/<%= data.id %>?_method=PUT" method="post">
            <%- include('./layout/form', { entry: data }) %>
            <div class="actions">
                <button type="submit" class="btn">Save changes</button>
                <a class="btn btn-ghost" href="/diary/<%= data.id %>">Cancel</a>
            </div>
        </form>
    </section>
<%- include('./layout/footer') %>
