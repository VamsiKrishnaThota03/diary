<div class="form-group">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" required maxlength="200" value="<%= entry.title || '' %>" placeholder="What was today about?">
</div>
<div class="form-group">
    <label for="date">Date</label>
    <input type="date" id="date" name="date" required value="<%= toInputDate(entry.date) %>">
</div>
<div class="form-group">
    <label for="description">Entry</label>
    <textarea name="description" id="description" rows="10" required placeholder="Write freely…"><%= entry.description || '' %></textarea>
</div>
